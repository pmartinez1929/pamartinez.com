---

{/* Oculto por defecto: el script lo muestra si el visitante aún no eligió. Sin JS no se carga GTM, así que no hace falta */}
<div
  id="consent"
  role="region"
  aria-label="Consentimiento de cookies"
  hidden
  class="fixed inset-x-0 bottom-0 z-[60] border-t border-black/10 bg-white px-6 py-4 shadow-[0_-4px_16px_rgba(0,0,0,0.08)]"
>
  <div class="mx-auto flex max-w-[1100px] flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <p class="text-sm">
      Uso cookies de analítica para entender cómo se usa el sitio y mejorarlo. Solo se activan si las aceptas.{' '}
      <a class="font-medium text-navy underline" href="/privacidad/">Más información</a>
    </p>
    {/* Mismo peso visual para ambas opciones: rechazar debe ser tan fácil como aceptar */}
    <div class="grid shrink-0 grid-cols-2 gap-3">
      <button type="button" class="btn btn-navy" data-consent="denied">Rechazar</button>
      <button type="button" class="btn btn-red" data-consent="granted">Aceptar</button>
    </div>
  </div>
</div>

<script>
  type Choice = 'granted' | 'denied';
  const w = window as Window & { gtag?: (...args: unknown[]) => void; dataLayer?: object[] };
  const banner = document.getElementById('consent')!;

  const stored = (() => {
    try {
      return localStorage.getItem('consent');
    } catch {
      return null;
    }
  })();
  if (stored !== 'granted' && stored !== 'denied') banner.hidden = false;

  banner.addEventListener('click', (e) => {
    const value = (e.target as Element).closest<HTMLButtonElement>('[data-consent]')?.dataset.consent as Choice | undefined;
    if (!value) return;
    try {
      localStorage.setItem('consent', value);
    } catch {}
    w.gtag?.('consent', 'update', {
      ad_storage: value,
      ad_user_data: value,
      ad_personalization: value,
      analytics_storage: value,
    });
    // Dispara en GTM las etiquetas que no son de Google (Clarity) en la misma visita en que se acepta
    if (value === 'granted') w.dataLayer?.push({ event: 'consent_granted' });
    banner.hidden = true;
  });

  for (const btn of document.querySelectorAll('[data-consent-open]')) {
    btn.addEventListener('click', () => {
      banner.hidden = false;
      banner.querySelector('button')?.focus();
    });
  }
</script>
