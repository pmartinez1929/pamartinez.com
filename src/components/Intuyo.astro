---
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';
---

<section id="intuyo" class="bg-navy text-white">
  <div class="mx-auto grid max-w-[1100px] items-center gap-12 px-6 py-20 md:grid-cols-[1.2fr_1fr]">
    <div>
      <SectionHeading {...site.sections.intuyo} tone="dark" />
      <p class="mt-5 text-white/90">{site.intuyo.text}</p>
      <p class="mt-3 text-sm text-aqua">{site.intuyo.status}</p>
      {/* hover y foco propios: el hover navy de .btn-red y el outline navy global no se ven sobre la banda navy */}
      <a
        class="btn btn-red mt-8 hover:bg-blue focus-visible:outline-white"
        href={site.intuyo.instagram}
        data-track="social"
        data-track-label={site.intuyo.name}
        target="_blank"
        rel="noopener noreferrer"
      >
        {site.intuyo.ctaLabel}
      </a>
    </div>
    <div class="order-first flex items-center justify-center rounded-2xl bg-white p-8 md:order-none">
      <img src="/svg/intuyo-badge.svg" alt="Intuyo" width="326" height="158" class="w-full max-w-[280px]" />
    </div>
  </div>
</section>
